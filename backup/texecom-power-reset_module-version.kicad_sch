	)
	(text "HARDWARE TIMEOUT (74HCT4538 @ 5V)\nRelay ON = GPIO high AND < T since rising edge\nT = 0.7 x Rext x Cext = 0.7 x 1M x 10uF = ~7 s\n(Tasmota PulseTime 3.0 / 3.5 s is always shorter)\nR9/R10 1k: protect ESP GPIO if 5V rail is off (USB only)\nR11/R12 100R: TI rapid power-down protection for Cext\nR7/R8 220R: relay opto input current ~5 mA\nJP1/JP2 = Q links (fit), JP3/JP4 = nQ links (DNP)"
		(exclude_from_sim no)
		(at 241.3 78.74 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "49df322d-3f9d-43b1-b081-603f2ee17179")
	)
	(text "J7 -> relay module header (JST-XH to DuPont lead)\n1 CH1, 2 CH2, 3 GND, 4 VCC (+5V)"
		(exclude_from_sim no)
		(at 236.22 172.72 0)
		(effects
